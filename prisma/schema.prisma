datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  phone        String?
  role         String    @default("USER") // USER, ADMIN
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED
  expireAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  slips         PaymentSlip[]
  bandwidthLogs BandwidthLog[]

  @@map("users")
}

model Package {
  id           String   @id @default(uuid())
  name         String
  price        Float
  durationDays Int
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  slips PaymentSlip[]

  @@map("packages")
}

model PaymentSlip {
  id        String   @id @default(uuid())
  userId    String
  packageId String
  amount    Float
  slipUrl   String   // Base64 or uploaded image URL
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@map("payment_slips")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("system_settings")
}

// Per-session bandwidth tracking (pulled from OpenNDS ndsctl)
model BandwidthLog {
  id           String    @id @default(uuid())
  mac          String    // client MAC address
  userId       String?   // linked user if known
  downloadMb   Float     @default(0)
  uploadMb     Float     @default(0)
  sessionStart DateTime?
  recordedAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mac])
  @@index([recordedAt])
  @@map("bandwidth_logs")
}

// DNS query logs per client (from dnsmasq log-queries)
model DnsLog {
  id        BigInt   @id @default(autoincrement())
  mac       String?  // client MAC (resolved from ARP)
  clientIp  String
  domain    String
  queriedAt DateTime @default(now())

  @@index([mac, queriedAt])
  @@index([clientIp, queriedAt])
  @@index([domain])
  @@map("dns_logs")
}
